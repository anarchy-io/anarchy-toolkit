<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- This file intentionally does NOT import the repo-root Directory.Build.targets, keeping the
       Fallout build project isolated from the toolkit's packaging conventions. -->

  <!-- A ProjectReference does not bring in buildTransitive files the way the package does, so import them
       explicitly: they serve the NuGet.* assemblies from the installed SDK (see the file for why). -->
  <Import Project="..\src\Build.Fallout\buildTransitive\Anarchy.Toolkit.Build.Fallout.targets" />

</Project>
