<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Build</RootNamespace>
    <Nullable>enable</Nullable>
    <NoWarn>CS0649;CS0169</NoWarn>
    <FalloutRootDirectory>..</FalloutRootDirectory>
    <FalloutScriptDirectory>..</FalloutScriptDirectory>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Verbosity Condition="'$(Verbosity)' == ''">quiet</Verbosity>
    <!-- The build project is a tool, never a shipped package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The build components live in the solution itself (Anarchy.Toolkit.Automation.Build), so the build always
         runs the code it is building and packing. -->
    <ProjectReference Include="..\src\Automation.Build\Automation.Build.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fallout.Common" />
    <PackageReference Include="Fallout.Tooling.Generator" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Directory.Packages.props">
      <Link>Directory.Packages.props</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\.anarchy-toolkit.json" Link=".anarchy-toolkit.json" />
    <None Remove="..\.fallout\temp\build.log" />
    <None Remove="..\.fallout\temp\build.2026-11-27_15-14-43.log" />
    <None Remove="..\.fallout\temp\build.2026-11-27_15-33-21.log" />
    <None Remove="..\.fallout\temp\build.2026-11-27_15-56-47.log" />
    <None Remove="..\.fallout\temp\build.2026-11-27_15-59-05.log" />
    <None Remove="..\.fallout\temp\build.2026-11-27_16-00-30.log" />
    <None Remove="..\.fallout\temp\build.2026-11-27_16-04-40.log" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="logs\" />
  </ItemGroup>

</Project>
