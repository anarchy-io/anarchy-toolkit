<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <PackageId>Anarchy.Toolkit.Runtime.Web</PackageId>
    <AssemblyName>Anarchy.Toolkit.Runtime.Web</AssemblyName>
    <RootNamespace>Anarchy.Toolkit.Runtime.Web</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Shared REST API pipeline: startup bases, entry points, middleware, auth, and presentation helpers. Swagger is opt-in through Anarchy.Toolkit.Runtime.Web.Swagger.</Description>
    <!-- Library web project: no implicit Program entry point required. -->
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.Telemetry\Core.Telemetry.csproj" />
    <ProjectReference Include="..\Runtime\Runtime.csproj" />
    <ProjectReference Include="..\Infrastructure.Http\Infrastructure.Http.csproj" />
    <ProjectReference Include="..\Core.Health\Core.Health.csproj" />
    <ProjectReference Include="..\Core.Persistence.Abstractions\Core.Persistence.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

</Project>
