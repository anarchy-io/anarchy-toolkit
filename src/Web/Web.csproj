<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <PackageId>Anarchy.Toolkit.Web</PackageId>
    <AssemblyName>Anarchy.Toolkit.Web</AssemblyName>
    <RootNamespace>Anarchy.Toolkit.Web</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Shared REST API pipeline: startup bases, entry points, middleware, auth, swagger, and presentation helpers.</Description>
    <!-- Library web project: no implicit Program entry point required. -->
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hosting\Hosting.csproj" />
    <ProjectReference Include="..\Infrastructure.Http\Infrastructure.Http.csproj" />
    <ProjectReference Include="..\Core.Health\Core.Health.csproj" />
    <ProjectReference Include="..\Core.Persistence.Abstractions\Core.Persistence.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer" />
    <PackageReference Include="IdentityServer4.AccessTokenValidation" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

</Project>
