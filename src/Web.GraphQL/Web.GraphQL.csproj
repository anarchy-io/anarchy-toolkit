<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <PackageId>Anarchy.Toolkit.Web.GraphQL</PackageId>
    <AssemblyName>Anarchy.Toolkit.Web.GraphQL</AssemblyName>
    <RootNamespace>Anarchy.Toolkit.Web.GraphQL</RootNamespace>
    <Version>1.0.4</Version>
    <Description>GraphQL wiring for ASP.NET Core APIs: schema base, server registration with graph-type discovery, and policy-protected endpoint plus GraphiQL playground middleware.</Description>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GraphQL" />
    <PackageReference Include="GraphQL.Server.Transports.AspNetCore" />
    <PackageReference Include="GraphQL.Server.Ui.GraphiQL" />
  </ItemGroup>

</Project>
