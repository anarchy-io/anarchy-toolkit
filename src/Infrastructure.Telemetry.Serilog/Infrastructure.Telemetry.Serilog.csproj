<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Anarchy.Toolkit.Infrastructure.Telemetry.Serilog</PackageId>
    <AssemblyName>Anarchy.Toolkit.Infrastructure.Telemetry.Serilog</AssemblyName>
    <RootNamespace>Anarchy.Toolkit.Infrastructure.Telemetry.Serilog</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Optional Serilog integration for Anarchy telemetry: logging provider registration, console defaults for composition roots, a structured-exception enricher and opt-in log-based metrics.</Description>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.Telemetry\Core.Telemetry.csproj" />
    <ProjectReference Include="..\Infrastructure.CorrelationId\Infrastructure.CorrelationId.csproj" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

</Project>
