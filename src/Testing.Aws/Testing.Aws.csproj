<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Anarchy.Toolkit.Testing.Aws</PackageId>
    <AssemblyName>Anarchy.Toolkit.Testing.Aws</AssemblyName>
    <RootNamespace>Anarchy.Toolkit.Testing.Aws</RootNamespace>
    <Version>1.0.5</Version>
    <Description>AWS messaging test helpers (SNS/SQS helpers, typically against LocalStack, and SqsMessageFixture with gzip/zlib bodies) for message-broker integration tests.</Description>
    <IsPackable>true</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Testing\Testing.csproj" />
    <ProjectReference Include="..\Infrastructure.Messaging.Aws\Infrastructure.Messaging.Aws.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.SimpleNotificationService" />
    <PackageReference Include="AWSSDK.SQS" />
    <PackageReference Include="Amazon.Lambda.SQSEvents" />
  </ItemGroup>

</Project>
