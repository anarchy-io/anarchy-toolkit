<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Anarchy.Toolkit.Runtime</AssemblyName>
    <PackageId>Anarchy.Toolkit.Runtime</PackageId>
    <RootNamespace>Anarchy.Toolkit.Runtime</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Generic startup and entry-point bootstrapping for Jobs and Workers (local, container or systemd); AWS Lambda hosting lives in Anarchy.Toolkit.Runtime.Aws.</Description>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bootstrap\Bootstrap.csproj" />
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
  </ItemGroup>

</Project>
