@if (IsOpen)
{
    <div class="modal-overlay" @onclick="CloseAsync">
        <div class="form-section modal-content confirm-modal-content" @onclick:stopPropagation="true">
            <button type="button" class="confirm-modal-close" aria-label="Close" @onclick="CloseAsync">&times;</button>
            <h2>@Title</h2>
            @ChildContent
            <form class="confirm-modal-form" @onsubmit="ConfirmAsync" @onsubmit:preventDefault="true">
                <label for="@_inputId">Type <code>@Keyword</code> to confirm:</label>
                <input id="@_inputId" type="text" autocomplete="off" @bind="_input" @bind:event="oninput" />
                <button type="submit" class="btn @ConfirmButtonClass" disabled="@(!IsValid)">@ConfirmButtonLabel</button>
            </form>
        </div>
    </div>
}

@code {
    private readonly string _inputId = $"typedConfirmation-{Guid.NewGuid():N}";
    private string _input = string.Empty;

    /// <summary>Whether the modal is visible. Closing it clears the typed text.</summary>
    [Parameter] public bool IsOpen { get; set; }
    /// <summary>The modal heading.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    /// <summary>The exact (case-sensitive) text the user must type to enable confirmation; surrounding whitespace is ignored.</summary>
    [Parameter, EditorRequired] public string Keyword { get; set; } = string.Empty;
    /// <summary>Text of the confirm button.</summary>
    [Parameter, EditorRequired] public string ConfirmButtonLabel { get; set; } = string.Empty;
    /// <summary>CSS class of the confirm button. Defaults to <c>btn-danger</c>.</summary>
    [Parameter] public string ConfirmButtonClass { get; set; } = "btn-danger";
    /// <summary>The modal body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Invoked when the form is submitted with the correct keyword. The parent is responsible for closing the modal.</summary>
    [Parameter] public EventCallback OnConfirm { get; set; }
    /// <summary>Invoked when the modal is cancelled or closed.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    private bool IsValid => string.Equals(_input.Trim(), Keyword, StringComparison.Ordinal);

    /// <summary>Clears the typed text when the modal is closed.</summary>
    protected override void OnParametersSet()
    {
        if (!IsOpen)
        {
            _input = string.Empty;
        }
    }

    private async Task CloseAsync()
    {
        _input = string.Empty;
        await OnClose.InvokeAsync();
    }

    private async Task ConfirmAsync()
    {
        if (!IsValid)
        {
            return;
        }

        _input = string.Empty;
        await OnConfirm.InvokeAsync();
    }
}
