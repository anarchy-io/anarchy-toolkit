@inject IUiSessionContext SessionContext
@inject LoginPresenter Presenter
@inject NavigationManager Navigation
@inject UiAuthenticationOptions AuthenticationOptions

<div class="login-container">
    <div class="login-card">
        <h1>
            @if (string.IsNullOrEmpty(LogoPath))
            {
                @Title
            }
            else
            {
                <img src="@Presenter.GetRoute(LogoPath)" alt="@Title" />
            }
        </h1>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <p class="subtitle">@Subtitle</p>
        }

        @if (!string.IsNullOrEmpty(Presenter.ErrorMessage))
        {
            <div class="alert alert-error">
                <p>@Presenter.ErrorMessage</p>
            </div>
        }

        <form method="post" action="@Presenter.GetRoute(AuthenticationOptions.LoginEndpointPath)">
            <AntiforgeryToken />

            @if (Presenter.ShowEnvironmentSelector)
            {
                <div class="form-group">
                    <label for="targetEnvironment">Target Environment:</label>
                    <select id="targetEnvironment" name="targetEnvironment" @bind="Presenter.SelectedEnvironment">
                        @foreach (var env in Presenter.AvailableEnvironments)
                        {
                            <option value="@env">@env</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <input type="hidden" name="targetEnvironment" value="@Presenter.SelectedEnvironment" />
            }

            <div class="form-group">
                <label for="clientId">Client ID:</label>
                <input type="text" id="clientId" name="clientId" required placeholder="Enter client ID" />
            </div>

            <div class="form-group">
                <label for="clientSecret">Client Secret:</label>
                <input type="password" id="clientSecret" name="clientSecret" required placeholder="Enter client secret" />
            </div>

            <button type="submit" class="btn btn-primary">Login</button>
        </form>

        @if (ChildContent is not null)
        {
            <div class="login-info">
                @ChildContent
            </div>
        }
    </div>
</div>

@code {
    /// <summary>Application name; the logo's alt text, or the heading when no logo is set.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Route of the logo image (e.g. "logo.png"), resolved against the UI base path.</summary>
    [Parameter] public string? LogoPath { get; set; }

    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Optional info shown under the form.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Presenter.Initialize();

        if (await SessionContext.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo(Presenter.GetRoute(AuthenticationOptions.HomePath), forceLoad: true);
            return;
        }

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        var error = query.TryGetValue(UiLoginErrors.QueryParameter, out var errorValue)
            ? errorValue.ToString()
            : string.Empty;

        Presenter.SetErrorFromQueryParameter(error);
    }
}
