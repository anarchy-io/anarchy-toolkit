<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <PackageId>Anarchy.Toolkit.Runtime.Web.Swagger</PackageId>
    <AssemblyName>Anarchy.Toolkit.Runtime.Web.Swagger</AssemblyName>
    <RootNamespace>Anarchy.Toolkit.Runtime.Web.Swagger</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Opt-in Swagger/OpenAPI for toolkit REST APIs: the OpenAPI document (OAuth2 scheme, authorization and Accept-Encoding filters, runtime description) and the themed Swagger UI (AddToolkitSwagger).</Description>
    <!-- Library web project: no implicit Program entry point required. -->
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Runtime.Web\Runtime.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

</Project>
