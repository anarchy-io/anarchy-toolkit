<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>anarchy-toolkit</ToolCommandName>
    <PackageId>Anarchy.Toolkit.Automation.Build.Cli</PackageId>
    <AssemblyName>Anarchy.Toolkit.Automation.Build.Cli</AssemblyName>
    <RootNamespace>Anarchy.Toolkit.Automation.Build.Cli</RootNamespace>
    <Version>4.0.0</Version>
    <Description>The anarchy-toolkit command: bootstrap Anarchy-based .NET solutions and scaffold APIs, jobs and UIs into them from guided wizards.</Description>
    <PackageTags>anarchy bootstrap scaffold dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <ProjectReference Include="..\Automation\Automation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Packages the generated projects reference. Only their versions are needed, embedded below; referencing the
         projects also lets release automation bump this tool whenever one of them is bumped. -->
    <ProjectReference Include="..\Automation.Build\Automation.Build.csproj" ReferenceOutputAssembly="false" ToolkitPackage="true" />
    <ProjectReference Include="..\Bootstrap\Bootstrap.csproj" ReferenceOutputAssembly="false" ToolkitPackage="true" />
    <ProjectReference Include="..\Runtime\Runtime.csproj" ReferenceOutputAssembly="false" ToolkitPackage="true" />
    <ProjectReference Include="..\Runtime.Aws\Runtime.Aws.csproj" ReferenceOutputAssembly="false" ToolkitPackage="true" />
    <ProjectReference Include="..\Runtime.Web\Runtime.Web.csproj" ReferenceOutputAssembly="false" ToolkitPackage="true" />
    <ProjectReference Include="..\Runtime.Web.Aws\Runtime.Web.Aws.csproj" ReferenceOutputAssembly="false" ToolkitPackage="true" />
    <ProjectReference Include="..\Runtime.Web.Swagger\Runtime.Web.Swagger.csproj" ReferenceOutputAssembly="false" ToolkitPackage="true" />
    <ProjectReference Include="..\Runtime.Web.Ui\Runtime.Web.Ui.csproj" ReferenceOutputAssembly="false" ToolkitPackage="true" />
    <ProjectReference Include="..\Runtime.Web.MockServer.Ui\Runtime.Web.MockServer.Ui.csproj" ReferenceOutputAssembly="false" ToolkitPackage="true" />
    <ProjectReference Include="..\Testing\Testing.csproj" ReferenceOutputAssembly="false" ToolkitPackage="true" />
    <ProjectReference Include="..\Testing.Runtime.Web\Testing.Runtime.Web.csproj" ReferenceOutputAssembly="false" ToolkitPackage="true" />
    <ProjectReference Include="..\Testing.MockServer\Testing.MockServer.csproj" ReferenceOutputAssembly="false" ToolkitPackage="true" />
  </ItemGroup>

  <!-- Embeds "AnarchyToolkitPackage:<PackageId>" = "<Version>" assembly metadata for each package above. -->
  <Target Name="CollectToolkitPackageProjects">
    <ItemGroup>
      <_ToolkitPackageProject Include="@(ProjectReference)" Condition="'%(ProjectReference.ToolkitPackage)' == 'true'" />
    </ItemGroup>
  </Target>

  <Target Name="EmbedToolkitPackageVersions" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="CollectToolkitPackageProjects"
          Outputs="%(_ToolkitPackageProject.Identity)">
    <XmlPeek XmlInputPath="%(_ToolkitPackageProject.FullPath)" Query="/Project/PropertyGroup/PackageId/text()">
      <Output TaskParameter="Result" PropertyName="_ToolkitPackageId" />
    </XmlPeek>
    <XmlPeek XmlInputPath="%(_ToolkitPackageProject.FullPath)" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="_ToolkitPackageVersion" />
    </XmlPeek>
    <Error Condition="'$(_ToolkitPackageId)' == '' Or '$(_ToolkitPackageVersion)' == ''"
           Text="%(_ToolkitPackageProject.Identity) must declare an explicit PackageId and Version." />
    <ItemGroup>
      <AssemblyMetadata Include="AnarchyToolkitPackage:$(_ToolkitPackageId)" Value="$(_ToolkitPackageVersion)" />
    </ItemGroup>
  </Target>
</Project>
