<Project>

  <Target Name="AnarchyToolkitFalloutUseSdkProvidedNuGetAssemblies" AfterTargets="ResolvePackageAssets">

    <ItemGroup>
      <!-- Package-provided runtime assemblies that the SDK ships a counterpart for. -->
      <AnarchyToolkitFalloutNuGetAssembly
          Include="@(RuntimeCopyLocalItems)"
          Condition="$([System.String]::Copy('%(RuntimeCopyLocalItems.NuGetPackageId)').StartsWith('NuGet.'))
                     And Exists('$(MSBuildToolsPath)\%(RuntimeCopyLocalItems.Filename)%(RuntimeCopyLocalItems.Extension)')">
        <PackagePath>%(RuntimeCopyLocalItems.Identity)</PackagePath>
        <SdkPath>$(MSBuildToolsPath)\%(RuntimeCopyLocalItems.Filename)%(RuntimeCopyLocalItems.Extension)</SdkPath>
      </AnarchyToolkitFalloutNuGetAssembly>
    </ItemGroup>

    <GetAssemblyIdentity AssemblyFiles="@(AnarchyToolkitFalloutNuGetAssembly)" Condition="'@(AnarchyToolkitFalloutNuGetAssembly)' != ''">
      <Output TaskParameter="Assemblies" ItemName="AnarchyToolkitFalloutPackageIdentity" />
    </GetAssemblyIdentity>
    <ItemGroup>
      <AnarchyToolkitFalloutPackageIdentity>
        <PackageAssemblyVersion>%(Version)</PackageAssemblyVersion>
      </AnarchyToolkitFalloutPackageIdentity>
    </ItemGroup>
    <GetAssemblyIdentity AssemblyFiles="@(AnarchyToolkitFalloutPackageIdentity->'%(SdkPath)')" Condition="'@(AnarchyToolkitFalloutPackageIdentity)' != ''">
      <Output TaskParameter="Assemblies" ItemName="AnarchyToolkitFalloutSdkIdentity" />
    </GetAssemblyIdentity>
    <ItemGroup Condition="'@(AnarchyToolkitFalloutSdkIdentity)' != ''">
      <AnarchyToolkitFalloutSupersededNuGetAssembly Include="@(AnarchyToolkitFalloutSdkIdentity)"
          Condition="$([MSBuild]::VersionGreaterThanOrEquals('%(AnarchyToolkitFalloutSdkIdentity.Version)', '%(AnarchyToolkitFalloutSdkIdentity.PackageAssemblyVersion)'))" />
      <!--
        Swap the path for the SDK's copy while keeping the NuGet metadata (package id, version,
        path in package) intact, so that the deps.json stays consistent.
      -->
      <RuntimeCopyLocalItems Remove="@(AnarchyToolkitFalloutSupersededNuGetAssembly->'%(PackagePath)')" />
      <RuntimeCopyLocalItems Include="@(AnarchyToolkitFalloutSupersededNuGetAssembly->'%(SdkPath)')" />
    </ItemGroup>

  </Target>

</Project>
