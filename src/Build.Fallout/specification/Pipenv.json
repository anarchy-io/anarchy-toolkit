{
  "$schema": "https://raw.githubusercontent.com/ChrisonSimtian/Fallout/main/src/Fallout.Tooling.Generator/schema.json",
  "references": [
    "https://pipenv.pypa.io/en/latest/"
  ],
  "name": "Pipenv",
  "officialUrl": "https://pipenv.pypa.io/en/latest/",
  "pathExecutable": "pipenv",
  "tasks": [
    {
      "postfix": "Sync",
      "definiteArgument": "sync",
      "settingsClass": {}
    },
    {
      "postfix": "DeployArtifacts",
      "definiteArgument": "run deploy-artifacts",
      "settingsClass": {
        "properties": [
          {
            "name": "ManifestPath",
            "type": "string",
            "format": "--manifest-path {value}"
          }
        ]
      }
    }
  ]
}
