{
  "$schema": "https://raw.githubusercontent.com/ChrisonSimtian/Fallout/main/src/Fallout.Tooling.Generator/schema.json",
  "references": [
    "https://docs.microsoft.com/en-us/aspnet/core/security/app-secrets"
  ],
  "name": "DotNetUserSecrets",
  "officialUrl": "https://docs.microsoft.com/en-us/aspnet/core/security/app-secrets",
  "help": "The Secret Manager tool stores sensitive data during the development of a .NET project",
  "pathExecutable": "dotnet",
  "customLogger": true,
  "tasks": [
    {
      "help": "Sets a user secret",
      "postfix": "Set",
      "definiteArgument": "user-secrets set",
      "settingsClass": {
        "properties": [
          {
            "name": "Key",
            "type": "string",
            "format": "{value}",
            "secret": false,
            "position": 1,
            "help": "User secret key"
          },
          {
            "name": "Value",
            "type": "string",
            "format": "{value}",
            "secret": true,
            "position": 2,
            "help": "User secret value"
          },
          {
            "name": "Project",
            "type": "string",
            "format": "--project {value}",
            "help": "Project to set user secret for"
          }
        ]
      }
    }
  ]
}
