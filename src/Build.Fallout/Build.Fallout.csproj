<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Anarchy.Toolkit.Build.Fallout</PackageId>
    <AssemblyName>Anarchy.Toolkit.Build.Fallout</AssemblyName>
    <RootNamespace>Anarchy.Toolkit.Build.Fallout</RootNamespace>
    <Version>3.0.0</Version>
    <Description>Fallout build components: solution/test conventions, Microsoft.Testing.Platform-aware test runner, linting, layering checks, NuGet and ECR container release flows and local app runs.</Description>
    <PackageTags>fallout build ci</PackageTags>
    <Nullable>enable</Nullable>
    <!-- Fallout 11.0.18's transition-shim generator emits invalid XML paramrefs. -->
    <NoWarn>$(NoWarn);CS1734</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Build.Cli\Build.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Packaging" />
    <PackageReference Include="Fallout.Common" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Anarchy.Toolkit.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tool specifications the Infrastructure/Service/Tool/<Tool>/*.Generated.cs wrappers are generated from
         (`make fallout TARGET=GenerateTools`). -->
    <None Include="specification\*.json" />
    <!-- Imported by every build project that references this package, also when pulled in indirectly.
         See the file itself for why it is needed. -->
    <None Include="buildTransitive\$(PackageId).targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

</Project>
