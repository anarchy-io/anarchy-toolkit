<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Anarchy.Toolkit.Hosting</AssemblyName>
    <PackageId>Anarchy.Toolkit.Hosting</PackageId>
    <RootNamespace>Anarchy.Toolkit.Hosting</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Generic startup and entry-point bootstrapping for Jobs and Workers (Lambda and EC2).</Description>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Configuration\Configuration.csproj" />
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer" />
    <PackageReference Include="Amazon.Lambda.Core" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
  </ItemGroup>

</Project>
