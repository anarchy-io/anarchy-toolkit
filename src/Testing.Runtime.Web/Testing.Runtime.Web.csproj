<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <PackageId>Anarchy.Toolkit.Testing.Runtime.Web</PackageId>
    <AssemblyName>Anarchy.Toolkit.Testing.Runtime.Web</AssemblyName>
    <RootNamespace>Anarchy.Toolkit.Testing.Runtime.Web</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Web end-to-end test base (RestApiTestCaseBase exercising the native Kestrel pipeline) and HTTP request helpers; the AWS Lambda pipeline is tested with Anarchy.Toolkit.Testing.Runtime.Web.Aws.</Description>
    <IsPackable>true</IsPackable>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Testing\Testing.csproj" />
    <ProjectReference Include="..\Runtime.Web\Runtime.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

</Project>
