<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Anarchy.Toolkit.Build.Cli</PackageId>
    <AssemblyName>Anarchy.Toolkit.Build.Cli</AssemblyName>
    <RootNamespace>Anarchy.Toolkit.Build.Cli</RootNamespace>
    <Version>1.8.0</Version>
    <Description>Command-line foundations for Anarchy solutions: starter solution scaffolding, build hosts, application templates and dotnet CLI helpers.</Description>
    <PackageTags>anarchy cli scaffold</PackageTags>
    <Nullable>enable</Nullable>
    <!-- The scaffold includes the repository's dotfiles. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Anarchy.Toolkit.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <!-- Everything distributed to consumers: Boilerplate/ (Makefile, scripts, .gitignore, .editorconfig, skills) plus the repository's
         files. Embedded for the scaffolder at runtime and packed for reference. NuGet appends %(RecursiveDir) to a
         PackagePath ending in '/', so the PackagePath must not repeat it. -->
    <None Remove="Boilerplate\**" />
    <EmbeddedResource Include="Boilerplate\**" LogicalName="Anarchy.Boilerplate/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\global.json;..\..\nuget.config" LogicalName="Anarchy.Boilerplate/%(Filename)%(Extension)" />
    <None Include="Boilerplate\**;..\..\global.json;..\..\nuget.config" Pack="true" PackagePath="boilerplate/" Visible="false" />
  </ItemGroup>

</Project>
