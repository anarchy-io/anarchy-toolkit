<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Anarchy.Toolkit.Bootstrap.Aws</AssemblyName>
    <PackageId>Anarchy.Toolkit.Bootstrap.Aws</PackageId>
    <RootNamespace>Anarchy.Toolkit.Bootstrap.Aws</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Opt-in AWS configuration: AWS settings (IAwsAppSettings), KMS secret management (ModuleAwsSecretManagement), Secrets Manager values, the SSM Parameter Store configuration source and the X-Ray trace id context (IAmazonRequestContext).</Description>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bootstrap\Bootstrap.csproj" />
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.KeyManagementService" />
    <PackageReference Include="AWSSDK.SecretsManager" />
    <PackageReference Include="Amazon.Extensions.Configuration.SystemsManager" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
