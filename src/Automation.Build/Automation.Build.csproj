<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Anarchy.Toolkit.Automation.Build</PackageId>
    <AssemblyName>Anarchy.Toolkit.Automation.Build</AssemblyName>
    <RootNamespace>Anarchy.Toolkit.Automation.Build</RootNamespace>
    <Version>4.0.0</Version>
    <Description>Anarchy automation components, powered by Fallout Build: solution/test conventions, Microsoft.Testing.Platform-aware test runner, linting, layering checks, NuGet and ECR container release flows and local app runs.</Description>
    <PackageTags>fallout build ci</PackageTags>
    <Nullable>enable</Nullable>
    <!-- Fallout 11.0.18's transition-shim generator emits invalid XML paramrefs. -->
    <NoWarn>$(NoWarn);CS1734</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Automation\Automation.csproj" />
    <ProjectReference Include="..\Infrastructure.Telemetry.Serilog\Infrastructure.Telemetry.Serilog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Packaging" />
    <PackageReference Include="Fallout.Common" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <!-- DocFX ships its site templates as content files: let them flow to the build project's output, where
         IApiReferenceBuild looks for them. -->
    <PackageReference Include="Docfx.App" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Component\Tasks\ApiReference.targets" LogicalName="ApiReference.targets" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Anarchy.Toolkit.Tests.Unit" />
    <InternalsVisibleTo Include="Anarchy.Toolkit.Tests.Integration" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tool specifications the Infrastructure/Service/Tool/<Tool>/*.Generated.cs wrappers are generated from
         (`make anarchy TARGET=GenerateTools`). -->
    <None Include="specification\*.json" />
    <!-- Imported by every build project that references this package, also when pulled in indirectly.
         See the file itself for why it is needed. -->
    <None Include="buildTransitive\$(PackageId).targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

</Project>
