<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <PackageId>Anarchy.Toolkit.Testing.Runtime.Web.Aws</PackageId>
    <AssemblyName>Anarchy.Toolkit.Testing.Runtime.Web.Aws</AssemblyName>
    <RootNamespace>Anarchy.Toolkit.Testing.Runtime.Web.Aws</RootNamespace>
    <Version>1.0.0</Version>
    <Description>AWS Lambda web test toolkit: AwsRestApiTestCaseBase exercising both the native Kestrel and AWS Lambda pipelines, a testable Lambda entry point, API Gateway request conversion and API Gateway response assertions.</Description>
    <IsPackable>true</IsPackable>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Testing.Runtime.Web\Testing.Runtime.Web.csproj" />
    <ProjectReference Include="..\Runtime.Web.Aws\Runtime.Web.Aws.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.APIGatewayEvents" />
    <PackageReference Include="Amazon.Lambda.TestUtilities" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

</Project>
