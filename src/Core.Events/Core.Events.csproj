<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Anarchy.Toolkit.Core.Events</AssemblyName>
    <PackageId>Anarchy.Toolkit.Core.Events</PackageId>
    <RootNamespace>Anarchy.Toolkit.Core.Events</RootNamespace>
    <Version>1.0.4</Version>
