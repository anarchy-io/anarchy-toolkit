<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Anarchy.Toolkit.Infrastructure.Persistence.Db</PackageId>
    <AssemblyName>Anarchy.Toolkit.Infrastructure.Persistence.Db</AssemblyName>
    <RootNamespace>Anarchy.Toolkit.Infrastructure.Persistence.Db</RootNamespace>
    <Version>4.0.0</Version>
    <Description>Provider-agnostic relational database implementation of the persistence abstraction: connection pool, Unit of Work, resilience policy, dialect contract, repository bases, and service health reports.</Description>
