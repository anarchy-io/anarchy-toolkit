<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <PackageId>Anarchy.Toolkit.Runtime.Web.Aws</PackageId>
    <AssemblyName>Anarchy.Toolkit.Runtime.Web.Aws</AssemblyName>
    <RootNamespace>Anarchy.Toolkit.Runtime.Web.Aws</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Opt-in AWS Lambda hosting for toolkit REST APIs: AwsWebAppEntryPointBase behind API Gateway, the X-Amzn-Trace-Id middleware (UseAmazonTraceId) and Lambda path helpers.</Description>
    <!-- Library web project: no implicit Program entry point required. -->
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bootstrap.Aws\Bootstrap.Aws.csproj" />
    <ProjectReference Include="..\Core.Telemetry\Core.Telemetry.csproj" />
    <ProjectReference Include="..\Runtime.Web\Runtime.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer" />
  </ItemGroup>

</Project>
