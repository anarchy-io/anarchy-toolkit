{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml"
        ]
      },
      {
        "files": [
          "toc.yml",
          "index.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      },
      {
        "src": "../portal/assets/css",
        "files": [
          "tokens.css"
        ],
        "dest": "public"
      },
      {
        "src": "../portal/assets/images/logo",
        "files": [
          "anarchy-512.png"
        ],
        "dest": "images"
      }
    ],
    "output": "../../artifacts/docs-api",
    "template": [
      "default",
      "modern",
      "template"
    ],
    "globalMetadata": {
      "_appName": "Anarchy I/O Toolkit",
      "_appTitle": "Anarchy I/O - Toolkit API",
      "_appLogoPath": "images/anarchy-512.png",
      "_appFaviconPath": "images/favicon.png",
      "_enableSearch": true,
      "_disableContribution": false,
      "_appFooter": "<div class=\"anarchy-footer\"><div class=\"anarchy-footer__legal\"><div>&copy; 2026 <a href=\"https://github.com/leandrommedeiros\">Leandro Mel&atilde;o Medeiros</a>. Powered by <a href=\"https://dotnet.github.io/docfx/\" rel=\"nofollow\">DocFX</a>.</div><div>Licensed under the <a href=\"https://github.com/anarchy-io/anarchy-toolkit/blob/main/LICENSE\">Apache License 2.0</a>. Third-party components keep their own licenses; see <a href=\"https://github.com/anarchy-io/anarchy-toolkit/blob/main/NOTICE\">NOTICE</a>.</div></div><ul class=\"anarchy-footer__links\"><li><a href=\"https://www.nuget.org/profiles/anarchy-io\" rel=\"nofollow noopener noreferrer\"><i class=\"bi bi-box-fill\" aria-hidden=\"true\"></i> NuGet.org</a></li><li><a href=\"https://github.com/anarchy-io/anarchy-toolkit\" rel=\"nofollow noopener noreferrer\"><i class=\"bi bi-github\" aria-hidden=\"true\"></i> GitHub</a></li></ul></div>",
      "_appLogoUrl": "https://anarchy-io.github.io/anarchy-toolkit/"
    },
    "sitemap": {
      "baseUrl": "https://anarchy-io.github.io/anarchy-toolkit/api/"
    }
  }
}
