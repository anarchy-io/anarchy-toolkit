<Project Sdk="Microsoft.NET.Sdk">

  <!-- Every unit test of the toolkit. Each top-level folder mirrors the src/ project it tests
       (e.g. Core/ tests src/Core), so namespaces stay Anarchy.Toolkit.Tests.Unit.<Project>.… -->
  <PropertyGroup>
    <AssemblyName>Anarchy.Toolkit.Tests.Unit</AssemblyName>
    <RootNamespace>Anarchy.Toolkit.Tests.Unit</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bootstrap\Bootstrap.csproj" />
    <ProjectReference Include="..\..\src\Bootstrap.Aws\Bootstrap.Aws.csproj" />
    <ProjectReference Include="..\..\src\Runtime.Aws\Runtime.Aws.csproj" />
    <ProjectReference Include="..\..\src\Runtime.Web.Aws\Runtime.Web.Aws.csproj" />
    <ProjectReference Include="..\..\src\Runtime.Web.Swagger\Runtime.Web.Swagger.csproj" />
    <ProjectReference Include="..\..\src\Automation.Build\Automation.Build.csproj" />
    <ProjectReference Include="..\..\src\Automation.Build.Cli\Automation.Build.Cli.csproj" />
    <ProjectReference Include="..\..\src\Automation\Automation.csproj" />
    <ProjectReference Include="..\..\src\Runtime.Workers\Runtime.Workers.csproj" />
    <ProjectReference Include="..\..\src\Core.Events\Core.Events.csproj" />
    <ProjectReference Include="..\..\src\Core.Health\Core.Health.csproj" />
    <ProjectReference Include="..\..\src\Core.Messaging.Abstractions\Core.Messaging.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Core.Telemetry\Core.Telemetry.csproj" />
    <ProjectReference Include="..\..\src\Core\Core.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure.CorrelationId\Infrastructure.CorrelationId.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure.Messaging.Aws\Infrastructure.Messaging.Aws.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure.Messaging.CloudEvents\Infrastructure.Messaging.CloudEvents.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure.Messaging.Kafka\Infrastructure.Messaging.Kafka.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure.Telemetry.Serilog\Infrastructure.Telemetry.Serilog.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure.Telemetry.StatsD\Infrastructure.Telemetry.StatsD.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure.Persistence.Db\Infrastructure.Persistence.Db.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure.Persistence.Db.Events\Infrastructure.Persistence.Db.Events.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure.Persistence.Db.Mysql\Infrastructure.Persistence.Db.Mysql.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure.Persistence.Db.Oracle\Infrastructure.Persistence.Db.Oracle.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure.Persistence.Db.Postgres\Infrastructure.Persistence.Db.Postgres.csproj" />
    <ProjectReference Include="..\..\src\Testing.Aws\Testing.Aws.csproj" />
    <ProjectReference Include="..\..\src\Testing.Kafka\Testing.Kafka.csproj" />
    <ProjectReference Include="..\..\src\Testing.Db.Mysql\Testing.Db.Mysql.csproj" />
    <ProjectReference Include="..\..\src\Testing.MockServer\Testing.MockServer.csproj" />
    <ProjectReference Include="..\..\src\Runtime.Web\Runtime.Web.csproj" />
    <ProjectReference Include="..\..\src\Runtime.Web.Ui\Runtime.Web.Ui.csproj" />
    <ProjectReference Include="..\..\src\Runtime.Web.MockServer\Runtime.Web.MockServer.csproj" />
    <ProjectReference Include="..\..\src\Runtime.Web.MockServer.Ui\Runtime.Web.MockServer.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brings Microsoft.AspNetCore.TestHost for the ASP.NET Core middleware tests. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build/: the repository build's package-hierarchy rules (build/ is a Fallout tool, not a referenceable project). -->
    <Compile Include="..\..\build\PackageHierarchy.cs" Link="Build\PackageHierarchy.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bootstrap/: test settings bound to AppSettings; TestHelper.TestSettings<AppSettings>() reads them from this
         assembly, and ModuleAppSettingsBaseTest loads them as "<AssemblyName>.appsettings*.json". -->
    <EmbeddedResource Include="Bootstrap\appsettings*.json" LogicalName="$(AssemblyName).%(Filename)%(Extension)" />

    <!-- Runtime/Workers/: this test assembly carries the build metadata itself (replacing the legacy
         TestAssemblies.WithMetadata helper assembly). BuildMetadataReader looks for "<AssemblyName>.Properties.build.meta.json". -->
    <EmbeddedResource Include="Runtime\Workers\TestAssemblies\build.meta.json"
                      LogicalName="$(AssemblyName).Properties.build.meta.json" />

    <!-- Runtime/Workers/: resources used by the TextResourceReader tests, resolved from the assembly name. -->
    <EmbeddedResource Include="Runtime\Workers\Helpers\Resources\resource1.txt"
                      LogicalName="$(AssemblyName).resource1.txt" />
    <EmbeddedResource Include="Runtime\Workers\Helpers\Resources\subfolder\resource2.txt"
                      LogicalName="$(AssemblyName).subfolder.resource2.txt" />
  </ItemGroup>

</Project>
