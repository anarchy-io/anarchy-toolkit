{
  "layering.mode": "folder",
  "layering.layers": ["Core", "Infrastructure", "Bootstrap", "Runtime", "Apps"],
  "layering.root": "src",
  "build.configuration": "Release",
  "build.sourceRoot": "src",
  "build.treatWarningsAsErrors": true,
  "tests.commonProject": "Common",
  "tests.kindAliases": [],
  "docker.composeFile": "docker/docker-compose.yml",
  "docker.waitFor": [],
  "docker.waitForHealthy": false,
  "docker.timeout": 60,
  "docker.startTimeout": 180,
  "mockServer.record": "artifacts/mock-server/requests.jsonl",
  "mockServer.expectations": [],
  "mockServer.verbosity": "normal",
  "mockServer.ui": true,
  "mockServer.timeout": 60,
  "documentation.dependencyMapOutput": "docs/dependency-map.html",
  "documentation.apiReferenceConfig": "docs-api/docfx.json",
  "dependencies.versionLock": "Major",
  "nuget.skipDuplicate": true,
  "container.dockerfile": "docker/Dockerfile",
  "agentSkills.directories": [".agents/skills"],
  "gitHooks.skipLintFix": false,
  "gitHooks.skipTestStatic": false,
  "gitHooks.skipTestRuntime": false,
  "scaffolding.swagger": true,
  "scaffolding.swaggerTheme": true,
  "scaffolding.appSettings": "isolated"
}
