{
  "$schema": "https://anarchy-io.github.io/anarchy-toolkit/schemas/anarchy-toolkit.schema.json",
  "layering": {
    "mode": "prefix",
    "layers": ["Core", "Infrastructure", "Bootstrap", "Runtime", "Automation"]
  },
  "build": {
    "configuration": "Release"
  },
  "docker": {
    "waitFor": [
      "anarchy-db-postgres",
      "anarchy-db-mysql",
      "anarchy-db-oracle",
      "anarchy-infra-aws"
    ],
    "waitForHealthy": true,
    "timeout": 600,
    "startTimeout": 600
  },
  "documentation": {
    "dependencyMapOutput": "docs/portal/dependency-map.html",
    "apiReferenceConfig": "docs/api-reference/docfx.json"
  },
  "agentSkills": {
    "prefix": "anarchy",
    "directories": [
      ".agents/skills",
      "src/Automation/Boilerplate/.agents/skills"
    ]
  },
  "release": {
    "base": "main"
  }
}
